<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Rhaghoorian.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Histórico">
    <Grid RowDefinitions="Auto,*" Padding="28,20" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="Histórico de traduções" StyleClass="Heading" />
                <Label Text="Guardado somente neste computador (SQLite). Nunca é enviado ao Firebase." StyleClass="Muted" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Limpar tudo" Command="{Binding ClearCommand}" StyleClass="Danger" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Nenhuma tradução feita ainda." StyleClass="Muted" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StyleClass="Card">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <Label Text="{Binding DirectionLabel}" StyleClass="Accent" />
                            <Label Grid.Column="1" Text="{Binding When}" StyleClass="Muted" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Source}" />
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Result}" FontAttributes="Bold" />
                            <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="8" Margin="0,4,0,0">
                                <Button Text="Reutilizar" Command="{Binding ReuseCommand}" StyleClass="Chip" />
                                <Button Text="Excluir" Command="{Binding DeleteCommand}" StyleClass="Danger" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
