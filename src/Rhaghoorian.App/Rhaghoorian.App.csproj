<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- O aplicativo é Windows nativo via .NET MAUI (sem Blazor/Electron/web). -->
    <TargetFrameworks>net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rhaghoorian.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Rhagho'oriano</ApplicationTitle>
    <ApplicationId>com.rhaghoorian.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Executável "solto" (sem MSIX): permite `dotnet run` e distribuição por pasta. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#6D28D9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuração e dados iniciais ficam centralizados fora do projeto e são embutidos no executável. -->
    <EmbeddedResource Include="..\..\config\appsettings.json" LogicalName="appsettings.json" />
    <EmbeddedResource Include="..\..\config\appsettings.Development.json" LogicalName="appsettings.Development.json" />
    <EmbeddedResource Include="..\..\config\appsettings.Production.json" LogicalName="appsettings.Production.json" />
    <EmbeddedResource Include="..\..\config\appsettings.local.json" LogicalName="appsettings.local.json" Condition="Exists('..\..\config\appsettings.local.json')" />
    <EmbeddedResource Include="..\..\data\dicionario_rhagho_oriano_atual.txt" LogicalName="dicionario_inicial.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rhaghoorian.Core\Rhaghoorian.Core.csproj" />
    <ProjectReference Include="..\Rhaghoorian.Infrastructure\Rhaghoorian.Infrastructure.csproj" />
    <ProjectReference Include="..\Rhaghoorian.Presentation\Rhaghoorian.Presentation.csproj" />
  </ItemGroup>

</Project>
